{% assign path_id = include.id | default: 'flowing-text' %}
<section class="flowing-text-section">
  <div class="container">
    <svg class="flowing-text" viewBox="0 0 800 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs>
        <path id="{{ path_id }}" d="M 20 220 C 220 60, 580 60, 780 220" />
      </defs>
      <text>
        <textPath href="#{{ path_id }}" startOffset="0%">
          {{ include.text | default: 'Curiosity → Craft → Impact' }}
        </textPath>
      </text>
    </svg>
    {% if include.subtext %}
      <p class="flowing-subtext">{{ include.subtext }}</p>
    {% endif %}
    {% if include.show_socials %}
      <div class="flowing-socials">
        {% include social.liquid %}
      </div>
    {% endif %}
  </div>
</section>


