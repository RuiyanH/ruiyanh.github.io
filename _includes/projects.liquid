<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    {% capture tags_attr %}
      {% if project.tags and project.tags.size > 0 %}
        {{ project.tags | join: '|' }}
      {% elsif project.category %}
        {{ project.category }}
      {% endif %}
    {% endcapture %}
    <div class="card h-100 hoverable" data-tags="{{ tags_attr | strip | downcase }}">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
      <!-- Hover/focus overlay -->
      <div class="card-overlay" aria-hidden="true">
        <div class="overlay-content">
          {% if project.description %}
            <p class="overlay-desc">{{ project.description }}</p>
          {% else %}
            <h3 class="overlay-title">{{ project.title }}</h3>
          {% endif %}
          {% if project.tags and project.tags.size > 0 %}
            <div class="overlay-tags">
              {% for tag in project.tags %}
                <span class="tag-badge" data-tag="{{ tag | downcase }}">{{ tag }}</span>
              {% endfor %}
            </div>
          {% elsif project.category %}
            <div class="overlay-tags">
              <span class="tag-badge" data-tag="{{ project.category | downcase }}">{{ project.category }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
