<div class="col">
  <a href="{% if project.demo_url %}{{ project.demo_url | relative_url }}{% elsif project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    {% capture tags_attr %}
      {% if project.tags and project.tags.size > 0 %}
        {{ project.tags | join: '|' }}
      {% elsif project.category %}
        {{ project.category }}
      {% endif %}
    {% endcapture %}
    <div class="card h-100 hoverable" data-tags="{{ tags_attr | strip | downcase }}">
      <div class="card-body">
        <div class="project-card-meta">
          {% if project.featured %}
            <span class="project-card-pill">Featured</span>
          {% endif %}
          {% if project.project_type %}
            <span class="project-card-pill">{{ project.project_type }}</span>
          {% elsif project.category %}
            <span class="project-card-pill">{{ project.category }}</span>
          {% endif %}
        </div>
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.result %}
          <p class="card-text project-result">{{ project.result }}</p>
        {% endif %}
        {% if project.tags and project.tags.size > 0 %}
          <div class="project-tags" aria-label="Project skills">
            {% for tag in project.tags limit: 4 %}
              <span class="tag-badge" data-tag="{{ tag | downcase }}">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
        <span class="project-card-action">
          {% if project.demo_url %}
            Open interactive demo
          {% elsif project.github %}
            GitHub + writeup
          {% else %}
            View project
          {% endif %}
        </span>
      </div>
    </div>
  </a>
</div>
