    <h2>Other</h2>
    <ul>
    {% for item in books %}
      {% assign cats_str = ' ' | append: (item.categories | join: ' ' | downcase) | append: ' ' %}
      {% assign is_data = cats_str contains ' machine-learning ' or cats_str contains ' deep-learning ' or cats_str contains ' ai ' or cats_str contains ' ml ' or cats_str contains ' data ' or cats_str contains ' statistics ' %}
      {% assign is_energy = cats_str contains ' energy ' or cats_str contains ' climate ' or cats_str contains ' environment ' or cats_str contains ' society ' %}
      {% assign is_lit = cats_str contains ' literature ' or cats_str contains ' fiction ' or cats_str contains ' novel ' %}
      {% unless is_data or is_energy or is_lit %}
        <figure class="cover">
          <a class="cover-link" href="{{ item.url | relative_url }}">
